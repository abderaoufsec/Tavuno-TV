# Tavuno Control API Environment Variables
# Copy this file to .env and fill in real values for local development

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tavuno
POSTGRES_USER=tavuno
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Dispatcharr
DISPATCHARR_URL=http://dispatcharr:9191
DISPATCHARR_API_KEY=CHANGE_ME
DISPATCHARR_EXPECTED_VERSION=0.28.0
DISPATCHARR_TIMEOUT_SECONDS=20.0
DISPATCHARR_SYNC_INTERVAL_SECONDS=3600

# Public Directus origin, used to turn stored file UUIDs into fetchable
# /assets/<uuid> URLs on catalog reads (A6). This must be the address *clients*
# can reach, not the compose-network one: 10.0.2.2 is the Android emulator's
# alias for the host. Leave blank and artwork references are returned untouched
# (placeholders) rather than rewritten to a path the device cannot resolve.
DIRECTUS_PUBLIC_URL=http://10.0.2.2:8055

# OvenMediaEngine
OME_API_URL=http://tavuno-ovenmediaengine:8081
OME_API_TOKEN=tavuno-m1-local
OME_PLAYBACK_BASE_URL=http://localhost:8080/media
# Set to 10.0.2.2 so Android emulators can reach Caddy/OME loopback URLs from any client.
# PLAYBACK_PUBLIC_HOST=10.0.2.2

# Playback Tokens
PLAYBACK_TOKEN_SECRET=CHANGE_ME
PLAYBACK_TOKEN_TTL_SECONDS=120

# Authentication (M9)
JWT_SECRET=CHANGE_ME_USE_RANDOM_64_HEX
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
PASSWORD_HASH_SCHEME=bcrypt

# Account Registration (M8.3)
FREE_LAUNCH=true
DEFAULT_PLAN_ID=1

# Email Service (M8.5)
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=noreply@tavuno.com
EMAIL_FROM_NAME=Tavuno
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_BASE_URL=https://tavuno.com
PASSWORD_RESET_TTL_SECONDS=3600

# Application
TAVUNO_ENV=development
TAVUNO_LOG_LEVEL=INFO
TAVUNO_CATALOG_CACHE_SECONDS=30

# Live-channel test scope (read-time filter; see docs/Live_Channel_Test_Scope.md).
# Empty allowlist + limit 0 = the whole synced catalog.
# TAVUNO_LIVE_CHANNEL_ALLOWLIST=6853,6854,8845
# TAVUNO_LIVE_CHANNEL_LIMIT=10

# Schema migrations
# Applies the SQL files in ./migrations at API startup, in filename order, recording
# each one in the tavuno_schema_migrations ledger. Every migration guards itself with
# IF NOT EXISTS / ON CONFLICT, so enabling this against an already-migrated database
# replays the set as no-ops instead of failing.
# It does not create a schema from nothing: these files patch the Directus base
# schema (../../tavuno-infra/scripts/apply-m2-schema.ps1) and fail where that has
# never run, starting with: relation "tavuno_profiles" does not exist.
TAVUNO_AUTO_MIGRATE=true

# Ops dashboard (M15) — read-only status page at GET /v1/ops, data at
# GET /v1/ops/summary. Send it as the X-Ops-Token header.
# Gated by a shared secret rather than an admin login, because free-launch
# mode (AUTH_OPEN_ACCESS) gives the guest identity role `user` and every
# admin-gated route would then 403.
# **Change this for production.** The default below only exists so a fresh
# clone has a working dashboard.
TAVUNO_OPS_TOKEN=tavuno-ops-local
