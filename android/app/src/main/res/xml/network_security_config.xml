<?xml version="1.0" encoding="utf-8"?>
<!--
    Production network posture: cleartext is refused outright.

    Everything a shipped build talks to must be HTTPS. The development exceptions (emulator and
    host loopback addresses, plus the local HTTP stack) live in the *debug* source set at
    src/debug/res/xml/network_security_config.xml, which replaces this file for debug builds only.
    Keeping them there is deliberate: a local-IP allowlist that sits in src/main ships inside the
    release APK, which is what this file previously did with a blanket
    <base-config cleartextTrafficPermitted="true">.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>

