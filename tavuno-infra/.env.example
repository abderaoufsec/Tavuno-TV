# Tavuno Infrastructure Environment Variables
# Copy this file to .env and fill in real values

# PostgreSQL
POSTGRES_DB=tavuno
POSTGRES_USER=tavuno
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME

# Directus
DIRECTUS_SECRET=CHANGE_ME
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME

# Dispatcharr
DISPATCHARR_POSTGRES_PASSWORD=CHANGE_ME

# Grafana
GRAFANA_ADMIN_USER=tavuno
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Dispatcharr Integration
DISPATCHARR_BASE_URL=http://localhost:9191
DISPATCHARR_API_KEY=CHANGE_ME
DISPATCHARR_EXPECTED_VERSION=0.28.0

# Authentication (M9) - for tavuno-control
JWT_SECRET=CHANGE_ME_USE_RANDOM_64_HEX
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
PASSWORD_HASH_SCHEME=bcrypt

# Optional
TAVUNO_ENV=development
TAVUNO_LOG_LEVEL=INFO
TAVUNO_CATALOG_CACHE_SECONDS=30
DISPATCHARR_SYNC_INTERVAL_SECONDS=3600
DISPATCHARR_TIMEOUT_SECONDS=20
PLAYBACK_TOKEN_SECRET=CHANGE_ME
PLAYBACK_TOKEN_TTL_SECONDS=120
